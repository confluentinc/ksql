# try-import (NOT hard import) so a fresh checkout / not-yet-generated preset
# file doesn't FATAL before `bazel run //:update_bazelrc` generates it. The
# generator keeps these lines idempotently.
try-import %workspace%/.bazel/bazelrc/common.bazelrc
try-import %workspace%/.bazel/bazelrc/java.bazelrc
try-import %workspace%/.bazel/bazelrc/ci.bazelrc

common --enable_bzlmod
common --define maven_version=0.0.0  # local placeholder; .bazelrc.release-version / CI --define overrides it (Phase 5)

# Match the repo's Maven bytecode target (Phase-0 audit: java.version=17, the
# parent's maven-compiler <release>${java.version}</release>).
build --java_language_version=17
build --java_runtime_version=remotejdk_17
build --tool_java_language_version=17
build --tool_java_runtime_version=remotejdk_17

# Error Prone was never enabled under the Maven build; the default Bazel Java
# toolchain runs its checks as ERROR. Demote to warnings so the Bazel build
# matches Maven's behavior without changing source during the migration. Does
# NOT relax Bazel's strict-deps checking.
build --javacopt=-XepAllErrorsAsWarnings

# Tests. Testcontainers-based tests (tag requires-docker) need a Docker
# daemon; they are skipped by default — run them where Docker exists with
# --test_tag_filters= . Ryuk is disabled per the skill's Testcontainers note.
# fails-on-darwin-arm64: tests that also fail under
# Maven on Apple-silicon macOS (JDK 17 Math.exp intrinsic / thread stack
# depth); they still run on Linux CI.
# Per-platform (not a plain `test` line): --enable_platform_specific_config in
# the common preset expands test:<os> at its position near the top, so a later
# plain `test --test_tag_filters` would override the macOS one.
test:linux --test_tag_filters=-requires-docker
test:windows --test_tag_filters=-requires-docker
test:macos --test_tag_filters=-requires-docker,-fails-on-darwin-arm64
test --test_env=TESTCONTAINERS_RYUK_DISABLED=true

# Default read-only remote cache (writes happen only from trusted CI). The
# --noremote_upload_local_results line ENFORCES read-only client-side.
common --remote_cache=https://bazel-external.dp.confluent.io:443
common --noremote_upload_local_results

# Stamped release builds (metadata). See Phase 5 for the maven_version wiring —
# the maven coordinate version comes from .bazelrc.release-version, NOT stamp.sh.
build:release -c opt --stamp --workspace_status_command=tools-bazel/stamp.sh

try-import %workspace%/user.bazelrc
### START SERVICE BOT MANAGED FOOTER ###
try-import ".bazelrc.release-version"
### END SERVICE BOT MANAGED FOOTER ###
