#!/bin/bash
# (Copyright) [2017 - 2017] Confluent, Inc.

#
# Use shellcheck to lint this file
#
# Find the server with ps, as kafka-server-stop does: jcmd is missing from JREs and can't see a JVM of
# another implementation (e.g. a HotSpot jcmd and an OpenJ9 server).
# shellcheck disable=SC2009
SERVERPIDS=$(ps axww | grep 'io\.confluent\.ksql\.rest\.server\.KsqlServerMain' | grep java | grep -v grep | awk '{print $1}')

if [ -z "$SERVERPIDS" ]; then
  echo "No server(s) to stop"
  exit 1
fi

for PID in $SERVERPIDS; do
  kill -s TERM "$PID"
  while kill -0 "$PID" >/dev/null 2>&1; do sleep 1; done
done
