        "src/test/java/io/confluent/ksql/api/client/ClientOAuthTest.java",
        "src/test/java/io/confluent/ksql/api/client/ClientTest.java",
        "src/test/java/io/confluent/ksql/api/client/ClientTlsMutualAuthTest.java",
        "src/test/java/io/confluent/ksql/api/client/ClientTlsTest.java",
        "src/test/java/io/confluent/ksql/api/client/impl/ClientImplTest.java",
        "src/test/java/io/confluent/ksql/api/client/impl/ClientOptionsImplTest.java",
        "src/test/java/io/confluent/ksql/api/client/impl/ColumnTypeImplTest.java",
        "src/test/java/io/confluent/ksql/api/client/impl/ConnectorDescriptionImplTest.java",
        "src/test/java/io/confluent/ksql/api/client/impl/ConnectorInfoImplTest.java",
        "src/test/java/io/confluent/ksql/api/client/impl/ConnectorTypeImplTest.java",
        "src/test/java/io/confluent/ksql/api/client/impl/ExecuteStatementResultImplTest.java",
        "src/test/java/io/confluent/ksql/api/client/impl/FieldInfoImplTest.java",
        "src/test/java/io/confluent/ksql/api/client/impl/HttpRequestImplTest.java",
        "src/test/java/io/confluent/ksql/api/client/impl/HttpResponseImplTest.java",
        "src/test/java/io/confluent/ksql/api/client/impl/InsertAckImplTest.java",
        "src/test/java/io/confluent/ksql/api/client/impl/PollableSubscriberTest.java",
        "src/test/java/io/confluent/ksql/api/client/impl/QueryInfoImplTest.java",
        "src/test/java/io/confluent/ksql/api/client/impl/RowImplTest.java",
        "src/test/java/io/confluent/ksql/api/client/impl/ServerInfoImplTest.java",
        "src/test/java/io/confluent/ksql/api/client/impl/SourceDescriptionImplTest.java",
        "src/test/java/io/confluent/ksql/api/client/impl/StreamInfoImplTest.java",
        "src/test/java/io/confluent/ksql/api/client/impl/StreamedQueryResultImplTest.java",
        "src/test/java/io/confluent/ksql/api/client/impl/TableInfoImplTest.java",
        "src/test/java/io/confluent/ksql/api/client/impl/TopicInfoImplTest.java",
        "src/test/java/io/confluent/ksql/api/client/integration/AssertClientIntegrationTest.java",
        "src/test/java/io/confluent/ksql/api/client/integration/ClientIntegrationTest.java",
        "src/test/java/io/confluent/ksql/api/client/integration/ClientMutationIntegrationTest.java",
        "src/test/java/io/confluent/ksql/api/client/integration/PushV2ClientContinueIntegrationTest.java",
        "src/test/java/io/confluent/ksql/api/client/integration/RestClientIntegrationTest.java",
        "src/test/java/io/confluent/ksql/api/client/integration/StreamStreamJoinsDeprecationNoticesIntegrationTest.java",
        "src/test/java/io/confluent/ksql/api/client/util/RowUtilTest.java",
    ],
    runtime_deps = KSQL_TEST_RUNTIME_DEPS,
)
