load("//tools-bazel:ksql_defs.bzl", "KSQL_DUMMY_LICENSE_FIRST", "KSQL_PARENT_DEPS", "KSQL_TEST_DATA", "KSQL_TEST_JVM_FLAGS", "KSQL_TEST_RUNTIME_DEPS")
load("//tools-bazel:library_wrappers.bzl", "java_export", "java_library", "jvm_junit_test_classes")

java_export(
    name = "ksqldb-api-client",
    srcs = glob(["src/main/java/**/*.java"]),
    # Maven also publishes the test-jar (maven-jar-plugin test-jar goal).
    classifier_artifacts = {"tests": ":ksqldb-api-client-tests"},
    javacopts = ["-parameters"],
    maven_coordinates = "io.confluent.ksql:ksqldb-api-client:$(maven_version)",
    visibility = ["//visibility:public"],
    # The pom re-declares common-utils with <scope>test</scope>, overriding the
    # compile-scope dep inherited from io.confluent:common.
    deps = [d for d in KSQL_PARENT_DEPS if d != "@maven//:io_confluent_common_utils"] + [
        "//ksqldb-common",
        "//ksqldb-rest-model",
        "@maven//:com_fasterxml_jackson_datatype_jackson_datatype_jdk8",
        "@maven//:com_google_guava_guava",
        "@maven//:io_netty_netty_codec_http",
        "@maven//:io_vertx_vertx_codegen",
        "@maven//:io_vertx_vertx_core",
        "@maven//:org_apache_kafka_kafka_clients",
        "@maven//:org_apache_kafka_kafka_streams",
        "@maven//:org_reactivestreams_reactive_streams",
    ],
)

# Stand-in for the Maven `tests` test-jar: the whole src/test tree,
# compiled once and shared by this module's tests and downstream modules.
java_library(
    name = "ksqldb-api-client-tests",
    srcs = glob(["src/test/java/**/*.java"]),
    javacopts = ["-parameters"],
    resource_strip_prefix = "ksqldb-api-client/src/test/resources",
    resources = glob(["src/test/resources/**"]),
    visibility = ["//visibility:public"],
    deps = KSQL_PARENT_DEPS + [
        ":ksqldb-api-client",
        "//ksqldb-common:ksqldb-common-project",
        "//ksqldb-engine:ksqldb-engine-project",
        "//ksqldb-engine:ksqldb-engine-tests",
        "//ksqldb-engine-common:ksqldb-engine-common-project",
        "//ksqldb-execution:ksqldb-execution-project",
        "//ksqldb-parser:ksqldb-parser-project",
        "//ksqldb-rest-app",
        "//ksqldb-rest-app:ksqldb-rest-app-tests",
        "//ksqldb-rest-client:ksqldb-rest-client-project",
        "//ksqldb-rest-model:ksqldb-rest-model-project",
        "//ksqldb-serde:ksqldb-serde-project",
        "//ksqldb-test-util",
        "//ksqldb-udf:ksqldb-udf-project",
        "@maven//:com_fasterxml_jackson_core_jackson_annotations",
        "@maven//:com_fasterxml_jackson_core_jackson_core",
        "@maven//:com_github_dasniko_testcontainers_keycloak",
        "@maven//:com_google_guava_guava",
        "@maven//:com_google_guava_guava_testlib",
        "@maven//:io_netty_netty_codec_http",
        "@maven//:io_vertx_vertx_core",
        "@maven//:io_vertx_vertx_web",
        "@maven//:io_vertx_vertx_web_client",
        "@maven//:junit_junit",
        "@maven//:org_apache_kafka_connect_api",
        "@maven//:org_apache_kafka_connect_json",
        "@maven//:org_apache_kafka_connect_test_plugins",
        "@maven//:org_apache_kafka_kafka_clients",
        "@maven//:org_apache_kafka_kafka_clients_test",
        "@maven//:org_apache_kafka_kafka_raft",
        "@maven//:org_apache_kafka_kafka_streams",
        "@maven//:org_eclipse_jetty_jetty_security",
        "@maven//:org_hamcrest_hamcrest_all",
        "@maven//:org_json_json",
        "@maven//:org_mockito_mockito_core",
        "@maven//:org_reactivestreams_reactive_streams",
    ],
)

jvm_junit_test_classes(
    name = "ksqldb-api-client-test-suite",
    classpath_first = KSQL_DUMMY_LICENSE_FIRST,
    data = KSQL_TEST_DATA,
    integration_srcs = [
        "src/test/java/io/confluent/ksql/api/client/integration/AssertClientIntegrationTest.java",
        "src/test/java/io/confluent/ksql/api/client/integration/ClientIntegrationTest.java",
        "src/test/java/io/confluent/ksql/api/client/integration/ClientMutationIntegrationTest.java",
        "src/test/java/io/confluent/ksql/api/client/integration/PushV2ClientContinueIntegrationTest.java",
        "src/test/java/io/confluent/ksql/api/client/integration/RestClientIntegrationTest.java",
        "src/test/java/io/confluent/ksql/api/client/integration/StreamStreamJoinsDeprecationNoticesIntegrationTest.java",
    ],
    jvm_flags = KSQL_TEST_JVM_FLAGS,
    per_test_args = {
        # Keycloak via Testcontainers (IdentityProviderService): needs a Docker daemon.
        "src/test/java/io/confluent/ksql/api/client/ClientOAuthTest.java": {"tags": ["requires-docker"]},
    },
    test_lib = ":ksqldb-api-client-tests",
    test_srcs = [
