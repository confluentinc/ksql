# Maven resource filtering: version.properties carries ${project.version} and
# is copied from BOTH resource roots (src/main/resources and
# src/main/resources/ksqldb), so the jar has /ksqldb/version.properties and
# /version.properties. $(maven_version) is the CP nano-version.
genrule(
    name = "version_properties",
    srcs = ["src/main/resources/ksqldb/version.properties"],
    outs = [
        "filtered_resources/ksqldb/version.properties",
        "filtered_resources/version.properties",
    ],
    cmd = " && ".join([
        "sed 's/$${project.version}/$(maven_version)/g' $< > $(location filtered_resources/ksqldb/version.properties)",
        "cp $(location filtered_resources/ksqldb/version.properties) $(location filtered_resources/version.properties)",
    ]),
)

java_export(
    name = "ksqldb-common",
    srcs = glob(["src/main/java/**/*.java"]),
    # java_export drops entries also present in a dependency"s jar; these are
    # this module"s own resources (a dependency ships a same-named root file).
    allowed_duplicate_names = ["version.properties"],
    # Maven also publishes the test-jar (maven-jar-plugin test-jar goal).
    classifier_artifacts = {"tests": ":ksqldb-common-tests"},
    maven_coordinates = "io.confluent.ksql:ksqldb-common:$(maven_version)",
    plugins = [
        "//third_party:log4j_graalvm_processor",
        "//third_party:log4j_plugin_processor",
    ],
    resource_strip_prefix = "ksqldb-common/filtered_resources",
    resources = [":version_properties"],
    visibility = ["//visibility:public"],
    deps = KSQL_PARENT_DEPS + [
        "//ksqldb-udf",
        "//third_party:bctls_fips-neverlink",
        "@maven//:com_fasterxml_jackson_core_jackson_annotations",
        "@maven//:com_fasterxml_jackson_core_jackson_core",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:com_fasterxml_jackson_datatype_jackson_datatype_jdk8",
        "@maven//:com_google_code_findbugs_jsr305",
        "@maven//:com_google_errorprone_error_prone_annotations",
        "@maven//:com_google_guava_guava",
        "@maven//:io_confluent_common_logging",
        "@maven//:io_confluent_kafka_connect_avro_converter",
        "@maven//:io_confluent_kafka_connect_json_schema_converter",
        "@maven//:io_confluent_kafka_schema_registry_client",
        "@maven//:io_vertx_vertx_codegen",
        "@maven//:io_vertx_vertx_core",
        "@maven//:jakarta_xml_bind_jakarta_xml_bind_api",
        "@maven//:org_apache_avro_avro",
        "@maven//:org_apache_commons_commons_lang3",
        "@maven//:org_apache_kafka_connect_api",
        "@maven//:org_apache_kafka_connect_json",
        "@maven//:org_apache_kafka_kafka_clients",
        "@maven//:org_apache_kafka_kafka_streams",
        "@maven//:org_reactivestreams_reactive_streams",
        "@maven//:org_slf4j_slf4j_api",
    ],
)

# Stand-in for the Maven `tests` test-jar: the whole src/test tree,
# compiled once and shared by this module's tests and downstream modules.
java_library(
    name = "ksqldb-common-tests",
    srcs = glob(["src/test/java/**/*.java"]),
    resource_strip_prefix = "ksqldb-common/src/test/resources",
    resources = glob(["src/test/resources/**"]),
    visibility = ["//visibility:public"],
    deps = KSQL_PARENT_DEPS + [
        ":ksqldb-common",
        "//ksqldb-test-util",
        "//ksqldb-udf:ksqldb-udf-project",
        "@maven//:com_fasterxml_jackson_core_jackson_annotations",
        "@maven//:com_fasterxml_jackson_core_jackson_core",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:com_fasterxml_jackson_datatype_jackson_datatype_jdk8",
        "@maven//:com_google_guava_guava",
        "@maven//:com_google_guava_guava_testlib",
        "@maven//:io_confluent_kafka_connect_json_schema_converter",
        "@maven//:io_confluent_kafka_schema_registry_client",
        "@maven//:io_vertx_vertx_core",
        "@maven//:junit_junit",
        "@maven//:org_apache_kafka_connect_api",
        "@maven//:org_apache_kafka_kafka_clients",
        "@maven//:org_apache_kafka_kafka_streams",
        "@maven//:org_bouncycastle_bc_fips",
        "@maven//:org_bouncycastle_bctls_fips",
        "@maven//:org_hamcrest_hamcrest",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_mockito_mockito_core",
        "@maven//:org_reactivestreams_reactive_streams",
    ],
)

