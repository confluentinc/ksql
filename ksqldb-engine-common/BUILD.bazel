load("//tools-bazel:ksql_defs.bzl", "KSQL_PARENT_DEPS", "KSQL_TEST_DATA", "KSQL_TEST_JVM_FLAGS", "KSQL_TEST_RUNTIME_DEPS")
load("//tools-bazel:library_wrappers.bzl", "java_export", "java_library", "jvm_junit_test_classes")

java_export(
    name = "ksqldb-engine-common",
    srcs = glob(["src/main/java/**/*.java"]),
    # Maven also publishes the test-jar (maven-jar-plugin test-jar goal).
    classifier_artifacts = {"tests": ":ksqldb-engine-common-tests"},
    maven_coordinates = "io.confluent.ksql:ksqldb-engine-common:$(maven_version)",
    visibility = ["//visibility:public"],
    deps = KSQL_PARENT_DEPS + [
        "//ksqldb-common",
        "//ksqldb-udf:ksqldb-udf-project",
        "@maven//:com_google_guava_guava",
        "@maven//:io_vertx_vertx_core",
        "@maven//:org_apache_kafka_connect_api",
    ],
)

# Stand-in for the Maven `tests` test-jar: the whole src/test tree,
# compiled once and shared by this module's tests and downstream modules.
java_library(
    name = "ksqldb-engine-common-tests",
    srcs = glob(["src/test/java/**/*.java"]),
    visibility = ["//visibility:public"],
    deps = KSQL_PARENT_DEPS + [
        ":ksqldb-engine-common",
        "//ksqldb-common:ksqldb-common-project",
        "//ksqldb-common:ksqldb-common-tests",
        "//ksqldb-test-util",
        "//ksqldb-udf:ksqldb-udf-project",
        "@maven//:com_google_guava_guava",
        "@maven//:junit_junit",
        "@maven//:org_apache_kafka_connect_api",
        "@maven//:org_hamcrest_hamcrest",
    ],
)

jvm_junit_test_classes(
    name = "ksqldb-engine-common-test-suite",
    data = KSQL_TEST_DATA,
    jvm_flags = KSQL_TEST_JVM_FLAGS,
    test_lib = ":ksqldb-engine-common-tests",
    test_srcs = [
        "src/test/java/io/confluent/ksql/schema/ksql/DefaultSqlValueCoercerTest.java",
        "src/test/java/io/confluent/ksql/schema/ksql/SqlBooleansTest.java",
        "src/test/java/io/confluent/ksql/schema/ksql/SqlDoublesTest.java",
        "src/test/java/io/confluent/ksql/schema/ksql/SqlTimeTypesTest.java",
    ],
    runtime_deps = KSQL_TEST_RUNTIME_DEPS,
)
