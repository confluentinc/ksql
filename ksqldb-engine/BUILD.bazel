# Exploded main classes for ClassFinder-based tests (see ksql_defs.bzl).
classes_dir(
    name = "ksqldb-engine-classes",
    lib = ":ksqldb-engine-lib",
)

# Module files at module-relative paths: surefire's cwd is the module dir.
module_cwd_files(
    name = "ksqldb-engine-cwd",
    # + ApprovalTests' *.approved.txt, located next to the test source.
    srcs = glob([
        "src/test/resources/**",
        "src/test/java/**/*.approved.txt",
        "src/test/java/**/QueryAnonymizerTest.java",
    ]),
)

