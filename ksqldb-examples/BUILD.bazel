load("//tools-bazel:ksql_defs.bzl", "KSQL_DUMMY_LICENSE_FIRST", "KSQL_PARENT_DEPS", "KSQL_TEST_DATA", "KSQL_TEST_JVM_FLAGS", "KSQL_TEST_RUNTIME_DEPS", "classes_dir", "classes_dir_test_args", "module_cwd_files")
load("//tools-bazel:library_wrappers.bzl", "java_export", "java_library", "jvm_junit_test_classes")

java_export(
    name = "ksqldb-examples",
    srcs = glob(["src/main/java/**/*.java"]),
    # Maven also publishes the test-jar (maven-jar-plugin test-jar goal).
    classifier_artifacts = {"tests": ":ksqldb-examples-tests"},
    maven_coordinates = "io.confluent.ksql:ksqldb-examples:$(maven_version)",
    resource_strip_prefix = "ksqldb-examples/src/main/resources",
    resources = glob(["src/main/resources/**"]),
    visibility = ["//visibility:public"],
    deps = KSQL_PARENT_DEPS + [
        "//ksqldb-common:ksqldb-common-project",
        "//ksqldb-engine",
        "//ksqldb-serde:ksqldb-serde-project",
        "@maven//:com_google_guava_guava",
        "@maven//:io_confluent_avro_avro_random_generator",
        "@maven//:io_confluent_kafka_connect_avro_converter",
        "@maven//:io_confluent_kafka_connect_avro_data",
        "@maven//:io_confluent_kafka_json_schema_provider",
        "@maven//:io_confluent_kafka_protobuf_provider",
        "@maven//:io_confluent_kafka_schema_registry_client",
        "@maven//:org_apache_avro_avro",
        "@maven//:org_apache_kafka_connect_api",
        "@maven//:org_apache_kafka_kafka_clients",
    ],
)

# Stand-in for the Maven `tests` test-jar: the whole src/test tree,
# compiled once and shared by this module's tests and downstream modules.
java_library(
    name = "ksqldb-examples-tests",
    srcs = glob(["src/test/java/**/*.java"]),
    resource_strip_prefix = "ksqldb-examples/src/test/resources",
    resources = glob(["src/test/resources/**"]),
    visibility = ["//visibility:public"],
    deps = KSQL_PARENT_DEPS + [
        ":ksqldb-examples",
        "//ksqldb-common:ksqldb-common-project",
        "//ksqldb-common:ksqldb-common-tests",
        "//ksqldb-test-util",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:com_google_guava_guava",
        "@maven//:io_confluent_avro_avro_random_generator",
        "@maven//:junit_junit",
        "@maven//:org_apache_avro_avro",
        "@maven//:org_apache_kafka_connect_api",
        "@maven//:org_apache_kafka_kafka_clients",
        "@maven//:org_hamcrest_hamcrest_all",
    ],
)

# GeneratorTest lists *.avro next to a classpath resource; its jar branch is
# broken, so it needs the module's resources as a directory (target/classes).
classes_dir(
    name = "ksqldb-examples-classes",
    lib = ":ksqldb-examples-lib",
)

# Module files at module-relative paths: surefire's cwd is the module dir.
module_cwd_files(
    name = "ksqldb-examples-cwd",
    srcs = glob(["src/main/resources/**"]),
)

jvm_junit_test_classes(
    name = "ksqldb-examples-test-suite",
    classpath_first = KSQL_DUMMY_LICENSE_FIRST,
    data = KSQL_TEST_DATA + [":ksqldb-examples-cwd"],
    integration_srcs = [
        "src/test/java/io/confluent/ksql/datagen/DataGenFunctionalTest.java",
    ],
    jvm_flags = KSQL_TEST_JVM_FLAGS,
    per_test_args = {
        "src/test/java/io/confluent/ksql/datagen/GeneratorTest.java": classes_dir_test_args("ksqldb-examples"),
    },
    test_lib = ":ksqldb-examples-tests",
    test_srcs = [
        "src/test/java/io/confluent/ksql/datagen/DataGenFunctionalTest.java",
        "src/test/java/io/confluent/ksql/datagen/DataGenProducerTest.java",
        "src/test/java/io/confluent/ksql/datagen/DataGenTest.java",
        "src/test/java/io/confluent/ksql/datagen/GeneratorTest.java",
        "src/test/java/io/confluent/ksql/datagen/RowGeneratorTest.java",
        "src/test/java/io/confluent/ksql/datagen/SessionManagerTest.java",
    ],
    runtime_deps = KSQL_TEST_RUNTIME_DEPS,
)
