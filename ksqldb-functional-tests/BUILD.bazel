# Exploded main classes for ClassFinder-based tests (see ksql_defs.bzl).
classes_dir(
    name = "ksqldb-functional-tests-classes",
    lib = ":ksqldb-functional-tests-lib",
)

# The QTT/RQTT loaders list test directories via ClassLoader.getResourceAsStream
# ("query-validation-tests"), which only yields a listing for a directory
# classpath entry (Maven's target/test-classes), not a jar. Prepend the test
# lib exploded to a directory named like Maven's (ClassFinder skips
# "/test-classes/" paths, exactly as under Maven).
classes_dir(
    name = "test-classes",
    lib = ":ksqldb-functional-tests-tests",
)

# Module files at module-relative paths (surefire cwd = module dir): the
# historical plans / test-runner trees, testing_tool_tests.json, the pom.xml
# TestCasePlanLoader reads for the version, QueriesToAnonymizeTest.txt, and
# KsqlTestingToolTest's "../ksqldb-engine/src/test/resources/udf-example-2.jar".
module_cwd_files(
    name = "ksqldb-functional-tests-cwd",
    srcs = glob([
        "src/test/resources/**",
        "src/test/java/**/*.txt",
        "src/test/java/**/QueryAnonymizerTest.java",  # ApprovalTests source lookup
    ]) + ["pom.xml"],
    root_symlinks = {
        "//ksqldb-engine:src/test/resources/udf-example-2.jar": "ksqldb-engine/src/test/resources/udf-example-2.jar",
    },
)

FUNCTIONAL_TEST_ARGS = ["--main_advice_classpath=ksqldb-functional-tests/test-classes"]

FUNCTIONAL_TEST_DATA = [
    ":test-classes",
    ":ksqldb-functional-tests-cwd",
] + glob(["src/test/resources/**"])  # PlannedTestPath: ./ksqldb-functional-tests/...

jvm_junit_test_classes(
    name = "ksqldb-functional-tests-test-suite",
    args = FUNCTIONAL_TEST_ARGS,
    data = KSQL_TEST_DATA + FUNCTIONAL_TEST_DATA,
    # failsafe multi-threaded-testing execution: **/RestQueryTranslationTest*.java
    integration_srcs = [
        "src/test/java/io/confluent/ksql/test/rest/batches/RestQueryTranslationTestBatch0.java",
        "src/test/java/io/confluent/ksql/test/rest/batches/RestQueryTranslationTestBatch1.java",
        "src/test/java/io/confluent/ksql/test/rest/batches/RestQueryTranslationTestBatch2.java",
        "src/test/java/io/confluent/ksql/test/rest/batches/RestQueryTranslationTestBatch3.java",
    ],
    jvm_flags = KSQL_TEST_JVM_FLAGS,
    per_test_args = {
        # QTT: thousands of parameterized cases; sharded (JUnit platform test
        # sharding) and given the `enormous` timeout.
        # fails-on-darwin-arm64: QTT/plan cases `math - exp` / `math - ln` hit
        # the same last-ulp Math.exp/log difference as ksqldb-engine ExpTest
        # (which fails under Maven on darwin-arm64 too); all other ~4,200
        # cases pass locally. They still run on Linux.
        "src/test/java/io/confluent/ksql/test/QueryTranslationTest.java": {
            "shard_count": 8,
            "size": "enormous",
            "tags": ["fails-on-darwin-arm64"],
        },
        "src/test/java/io/confluent/ksql/test/planned/PlannedTestsUpToDateTest.java": {
            "shard_count": 4,
            "size": "enormous",
            "tags": ["fails-on-darwin-arm64"],
        },
        # RQTT pull-query cases are timing-sensitive on this laptop: batch 0
        # fails 4/103 under Maven failsafe locally as well (same cases).
        "src/test/java/io/confluent/ksql/test/rest/batches/RestQueryTranslationTestBatch0.java": {"tags": ["fails-on-darwin-arm64"]},
        "src/test/java/io/confluent/ksql/test/rest/batches/RestQueryTranslationTestBatch1.java": {"tags": ["fails-on-darwin-arm64"]},
        "src/test/java/io/confluent/ksql/test/rest/batches/RestQueryTranslationTestBatch2.java": {"tags": ["fails-on-darwin-arm64"]},
        "src/test/java/io/confluent/ksql/test/rest/batches/RestQueryTranslationTestBatch3.java": {"tags": ["fails-on-darwin-arm64"]},
        "src/test/java/io/confluent/ksql/test/functional/ImmutabilityTest.java": classes_dir_test_args("ksqldb-functional-tests"),
    },
    test_lib = ":ksqldb-functional-tests-tests",
    test_srcs = [
        "src/test/java/io/confluent/ksql/test/QueryAnonymizerTest.java",
        "src/test/java/io/confluent/ksql/test/QueryTranslationTest.java",
        "src/test/java/io/confluent/ksql/test/SchemaTranslationTest.java",
        "src/test/java/io/confluent/ksql/test/SchemaTranslationWithSchemaIdTest.java",
        "src/test/java/io/confluent/ksql/test/driver/KsqlTesterTest.java",
        "src/test/java/io/confluent/ksql/test/functional/ImmutabilityTest.java",
        "src/test/java/io/confluent/ksql/test/model/KeyFormatNodeTest.java",
        "src/test/java/io/confluent/ksql/test/model/KsqlVersionTest.java",
        "src/test/java/io/confluent/ksql/test/model/PostConditionsNodeTest.java",
        "src/test/java/io/confluent/ksql/test/model/RecordNodeTest.java",
        "src/test/java/io/confluent/ksql/test/model/SchemaNodeTest.java",
        "src/test/java/io/confluent/ksql/test/model/SourceNodeTest.java",
        "src/test/java/io/confluent/ksql/test/planned/PlannedTestGeneratorTest.java",
        "src/test/java/io/confluent/ksql/test/planned/PlannedTestRewriterTest.java",
        "src/test/java/io/confluent/ksql/test/planned/PlannedTestsUpToDateTest.java",
