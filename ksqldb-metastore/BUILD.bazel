load("//tools-bazel:ksql_defs.bzl", "KSQL_DUMMY_LICENSE_FIRST", "KSQL_PARENT_DEPS", "KSQL_TEST_DATA", "KSQL_TEST_JVM_FLAGS", "KSQL_TEST_RUNTIME_DEPS", "classes_dir", "classes_dir_test_args")
load("//tools-bazel:library_wrappers.bzl", "java_export", "java_library", "jvm_junit_test_classes")

java_export(
    name = "ksqldb-metastore",
    srcs = glob(["src/main/java/**/*.java"]),
    # Maven also publishes the test-jar (maven-jar-plugin test-jar goal).
    classifier_artifacts = {"tests": ":ksqldb-metastore-tests"},
    javacopts = ["-parameters"],
    maven_coordinates = "io.confluent.ksql:ksqldb-metastore:$(maven_version)",
    visibility = ["//visibility:public"],
    deps = KSQL_PARENT_DEPS + [
        "//ksqldb-common",
        "//ksqldb-execution",
        "//ksqldb-udf:ksqldb-udf-project",
        "@maven//:com_google_code_findbugs_jsr305",
        "@maven//:com_google_errorprone_error_prone_annotations",
        "@maven//:com_google_guava_guava",
        "@maven//:io_vertx_vertx_core",
    ],
)

# Stand-in for the Maven `tests` test-jar: the whole src/test tree,
# compiled once and shared by this module's tests and downstream modules.
java_library(
    name = "ksqldb-metastore-tests",
    srcs = glob(["src/test/java/**/*.java"]),
    javacopts = ["-parameters"],
    visibility = ["//visibility:public"],
    deps = KSQL_PARENT_DEPS + [
        ":ksqldb-metastore",
        "//ksqldb-common:ksqldb-common-project",
        "//ksqldb-common:ksqldb-common-tests",
        "//ksqldb-execution:ksqldb-execution-project",
        "//ksqldb-serde:ksqldb-serde-project",
        "//ksqldb-test-util",
        "//ksqldb-udf:ksqldb-udf-project",
        "@maven//:com_google_guava_guava",
        "@maven//:com_google_guava_guava_testlib",
        "@maven//:junit_junit",
        "@maven//:org_apache_kafka_connect_api",
        "@maven//:org_apache_kafka_kafka_clients",
        "@maven//:org_apache_kafka_kafka_streams",
        "@maven//:org_hamcrest_hamcrest",
        "@maven//:org_mockito_mockito_core",
    ],
)

# Exploded main classes for ClassFinder-based tests (see ksql_defs.bzl).
classes_dir(
    name = "ksqldb-metastore-classes",
    lib = ":ksqldb-metastore-lib",
)

jvm_junit_test_classes(
    name = "ksqldb-metastore-test-suite",
    classpath_first = KSQL_DUMMY_LICENSE_FIRST,
    data = KSQL_TEST_DATA,
    jvm_flags = KSQL_TEST_JVM_FLAGS,
    per_test_args = {
        "src/test/java/io/confluent/ksql/metastore/ImmutabilityTest.java": classes_dir_test_args("ksqldb-metastore"),
        "src/test/java/io/confluent/ksql/metastore/model/MetaStoreModelTest.java": classes_dir_test_args("ksqldb-metastore"),
    },
    test_lib = ":ksqldb-metastore-tests",
    test_srcs = [
        "src/test/java/io/confluent/ksql/metastore/ImmutabilityTest.java",
        "src/test/java/io/confluent/ksql/metastore/MetaStoreImplTest.java",
        "src/test/java/io/confluent/ksql/metastore/model/MetaStoreModelTest.java",
        "src/test/java/io/confluent/ksql/metastore/model/StructuredDataSourceTest.java",
    ],
    runtime_deps = KSQL_TEST_RUNTIME_DEPS,
)
