load("//tools-bazel:ksql_defs.bzl", "KSQL_DUMMY_LICENSE_FIRST", "KSQL_PARENT_DEPS", "KSQL_TEST_DATA", "KSQL_TEST_JVM_FLAGS", "KSQL_TEST_RUNTIME_DEPS", "classes_dir", "classes_dir_test_args")
load("//tools-bazel:library_wrappers.bzl", "java_export", "java_library", "jvm_junit_test_classes")

# antlr4-maven-plugin equivalent (visitor=true, listener default true). The
# plugin derives the package from the grammar's directory under src/main/antlr4.
genrule(
    name = "sqlbase_antlr",
    srcs = ["src/main/antlr4/io/confluent/ksql/parser/SqlBase.g4"],
    outs = ["sqlbase_antlr.srcjar"],
    cmd = " && ".join([
        "OUT=$$(mktemp -d)",
        "$(location //tools-bazel/codegen:antlr4_tool) -visitor -listener -package io.confluent.ksql.parser -Xexact-output-dir -o $$OUT/io/confluent/ksql/parser $<",
        "find $$OUT -name '*.java' | sed \"s#^$$OUT/##\" | sort > $$OUT/files",
        "(cd $$OUT && $$OLDPWD/$(JAVABASE)/bin/jar cf $$OLDPWD/$@ @files)",
    ]),
    toolchains = ["@bazel_tools//tools/jdk:current_java_runtime"],
    tools = ["//tools-bazel/codegen:antlr4_tool"],
)

java_export(
    name = "ksqldb-parser",
    srcs = glob(["src/main/java/**/*.java"]) + [":sqlbase_antlr"],
    # Maven also publishes the test-jar (maven-jar-plugin test-jar goal).
    classifier_artifacts = {"tests": ":ksqldb-parser-tests"},
    javacopts = ["-parameters"],
    maven_coordinates = "io.confluent.ksql:ksqldb-parser:$(maven_version)",
    visibility = ["//visibility:public"],
    deps = KSQL_PARENT_DEPS + [
        "//ksqldb-common",
        "//ksqldb-execution:ksqldb-execution-project",
        "//ksqldb-metastore",
        "//ksqldb-serde:ksqldb-serde-project",
        "//ksqldb-udf:ksqldb-udf-project",
        "@maven//:com_approvaltests_approvaltests",
        "@maven//:com_fasterxml_jackson_core_jackson_core",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:com_fasterxml_jackson_datatype_jackson_datatype_jdk8",
        "@maven//:com_fasterxml_jackson_datatype_jackson_datatype_jsr310",
        "@maven//:com_google_code_findbugs_jsr305",
        "@maven//:com_google_errorprone_error_prone_annotations",
        "@maven//:com_google_guava_guava",
        "@maven//:org_antlr_antlr4_runtime",
        "@maven//:org_apache_commons_commons_lang3",
        "@maven//:org_apache_commons_commons_text",
        "@maven//:org_apache_kafka_kafka_clients",
        "@maven//:org_apache_kafka_kafka_streams",
    ],
)

# Stand-in for the Maven `tests` test-jar: the whole src/test tree,
# compiled once and shared by this module's tests and downstream modules.
java_library(
    name = "ksqldb-parser-tests",
    srcs = glob(["src/test/java/**/*.java"]),
    javacopts = ["-parameters"],
    resource_strip_prefix = "ksqldb-parser/src/test/resources",
    resources = glob(["src/test/resources/**"]),
    visibility = ["//visibility:public"],
    deps = KSQL_PARENT_DEPS + [
        ":ksqldb-parser",
        "//ksqldb-common:ksqldb-common-project",
        "//ksqldb-common:ksqldb-common-tests",
        "//ksqldb-execution:ksqldb-execution-project",
        "//ksqldb-metastore:ksqldb-metastore-project",
        "//ksqldb-metastore:ksqldb-metastore-tests",
        "//ksqldb-serde:ksqldb-serde-project",
        "//ksqldb-test-util",
        "//ksqldb-udf:ksqldb-udf-project",
        "@maven//:com_fasterxml_jackson_core_jackson_core",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:com_google_guava_guava",
        "@maven//:com_google_guava_guava_testlib",
        "@maven//:junit_junit",
        "@maven//:org_antlr_antlr4_runtime",
        "@maven//:org_apache_commons_commons_lang3",
        "@maven//:org_apache_kafka_connect_api",
        "@maven//:org_apache_kafka_kafka_clients",
        "@maven//:org_apache_kafka_kafka_streams",
        "@maven//:org_easymock_easymock",
        "@maven//:org_hamcrest_hamcrest",
        "@maven//:org_mockito_mockito_core",
    ],
)

