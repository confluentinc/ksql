load("//tools-bazel:ksql_defs.bzl", "KSQL_PARENT_DEPS", "KSQL_TEST_DATA", "KSQL_TEST_JVM_FLAGS", "KSQL_TEST_RUNTIME_DEPS", "classes_dir", "classes_dir_test_args")
load("//tools-bazel:library_wrappers.bzl", "java_export", "java_library", "jvm_junit_test_classes")

java_export(
    name = "ksqldb-rest-model",
    srcs = glob(["src/main/java/**/*.java"]),
    # Maven also publishes the test-jar (maven-jar-plugin test-jar goal).
    classifier_artifacts = {"tests": ":ksqldb-rest-model-tests"},
    maven_coordinates = "io.confluent.ksql:ksqldb-rest-model:$(maven_version)",
    visibility = ["//visibility:public"],
    deps = KSQL_PARENT_DEPS + [
        "//ksqldb-common",
        "//ksqldb-engine-common",
        "//ksqldb-udf:ksqldb-udf-project",
        "@maven//:com_fasterxml_jackson_core_jackson_annotations",
        "@maven//:com_fasterxml_jackson_core_jackson_core",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:com_fasterxml_jackson_datatype_jackson_datatype_guava",
        "@maven//:com_fasterxml_jackson_datatype_jackson_datatype_jdk8",
        "@maven//:com_google_errorprone_error_prone_annotations",
        "@maven//:com_google_guava_guava",
        "@maven//:io_netty_netty_codec_http",
        "@maven//:io_vertx_vertx_core",
        "@maven//:javax_ws_rs_javax_ws_rs_api",
        "@maven//:org_apache_commons_commons_lang3",
        "@maven//:org_apache_kafka_connect_api",
        "@maven//:org_apache_kafka_connect_runtime",
        "@maven//:org_apache_kafka_kafka_clients",
        "@maven//:org_apache_kafka_kafka_streams",
    ],
)

# Stand-in for the Maven `tests` test-jar: the whole src/test tree,
# compiled once and shared by this module's tests and downstream modules.
java_library(
    name = "ksqldb-rest-model-tests",
    srcs = glob(["src/test/java/**/*.java"]),
    visibility = ["//visibility:public"],
    deps = KSQL_PARENT_DEPS + [
        ":ksqldb-rest-model",
        "//ksqldb-common:ksqldb-common-project",
        "//ksqldb-test-util",
        "//ksqldb-udf:ksqldb-udf-project",
        "@maven//:com_fasterxml_jackson_core_jackson_annotations",
        "@maven//:com_fasterxml_jackson_core_jackson_core",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:com_google_guava_guava",
        "@maven//:com_google_guava_guava_testlib",
        "@maven//:junit_junit",
        "@maven//:org_apache_kafka_connect_api",
        "@maven//:org_apache_kafka_kafka_clients",
        "@maven//:org_apache_kafka_kafka_streams",
        "@maven//:org_hamcrest_hamcrest",
        "@maven//:org_mockito_mockito_core",
    ],
)

# Exploded main classes for ClassFinder-based tests (see ksql_defs.bzl).
classes_dir(
    name = "ksqldb-rest-model-classes",
    lib = ":ksqldb-rest-model-lib",
)

jvm_junit_test_classes(
    name = "ksqldb-rest-model-test-suite",
    data = KSQL_TEST_DATA,
    jvm_flags = KSQL_TEST_JVM_FLAGS,
    per_test_args = {
        "src/test/java/io/confluent/ksql/rest/entity/EntityTest.java": classes_dir_test_args("ksqldb-rest-model"),
        "src/test/java/io/confluent/ksql/rest/model/ImmutabilityTest.java": classes_dir_test_args("ksqldb-rest-model"),
    },
    test_lib = ":ksqldb-rest-model-tests",
    test_srcs = [
        "src/test/java/io/confluent/ksql/rest/ApiJsonMapperTest.java",
        "src/test/java/io/confluent/ksql/rest/ErrorsTest.java",
        "src/test/java/io/confluent/ksql/rest/GenericRowSerializationTest.java",
        "src/test/java/io/confluent/ksql/rest/QueryIdSerializationTest.java",
        "src/test/java/io/confluent/ksql/rest/entity/CommandStatusEntityTest.java",
        "src/test/java/io/confluent/ksql/rest/entity/EntityTest.java",
        "src/test/java/io/confluent/ksql/rest/entity/FunctionInfoTest.java",
        "src/test/java/io/confluent/ksql/rest/entity/KafkaTopicsListExtendedTest.java",
        "src/test/java/io/confluent/ksql/rest/entity/KafkaTopicsListTest.java",
        "src/test/java/io/confluent/ksql/rest/entity/KsqlErrorMessageTest.java",
        "src/test/java/io/confluent/ksql/rest/entity/KsqlMediaTypeTest.java",
        "src/test/java/io/confluent/ksql/rest/entity/KsqlRequestTest.java",
        "src/test/java/io/confluent/ksql/rest/entity/QueryStatusCountTest.java",
        "src/test/java/io/confluent/ksql/rest/entity/SchemaDescriptionFormatTest.java",
        "src/test/java/io/confluent/ksql/rest/entity/SchemaInfoTest.java",
        "src/test/java/io/confluent/ksql/rest/entity/ServerClusterIdTest.java",
        "src/test/java/io/confluent/ksql/rest/entity/ServerInfoTest.java",
        "src/test/java/io/confluent/ksql/rest/entity/ServerMetadataTest.java",
        "src/test/java/io/confluent/ksql/rest/entity/SourceDescriptionTest.java",
        "src/test/java/io/confluent/ksql/rest/entity/SourceInfoTest.java",
        "src/test/java/io/confluent/ksql/rest/model/ImmutabilityTest.java",
    ],
    runtime_deps = KSQL_TEST_RUNTIME_DEPS,
)
