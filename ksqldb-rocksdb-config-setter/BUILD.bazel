load("//tools-bazel:ksql_defs.bzl", "KSQL_PARENT_DEPS", "KSQL_TEST_DATA", "KSQL_TEST_JVM_FLAGS", "KSQL_TEST_RUNTIME_DEPS")
load("//tools-bazel:library_wrappers.bzl", "java_export", "java_library", "jvm_junit_test_classes")

java_export(
    name = "ksqldb-rocksdb-config-setter",
    srcs = glob(["src/main/java/**/*.java"]),
    # Maven also publishes the test-jar (maven-jar-plugin test-jar goal).
    classifier_artifacts = {"tests": ":ksqldb-rocksdb-config-setter-tests"},
    javacopts = ["-parameters"],
    maven_coordinates = "io.confluent.ksql:ksqldb-rocksdb-config-setter:$(maven_version)",
    visibility = ["//visibility:public"],
    deps = KSQL_PARENT_DEPS + [
        "//ksqldb-common",
        "@maven//:com_google_guava_guava",
        "@maven//:org_apache_kafka_kafka_clients",
        "@maven//:org_apache_kafka_kafka_streams",
        "@maven//:org_rocksdb_rocksdbjni",
    ],
)

# Stand-in for the Maven `tests` test-jar: the whole src/test tree,
# compiled once and shared by this module's tests and downstream modules.
java_library(
    name = "ksqldb-rocksdb-config-setter-tests",
    srcs = glob(["src/test/java/**/*.java"]),
    javacopts = ["-parameters"],
    visibility = ["//visibility:public"],
    deps = KSQL_PARENT_DEPS + [
        ":ksqldb-rocksdb-config-setter",
        "@maven//:com_google_guava_guava",
        "@maven//:junit_junit",
        "@maven//:org_apache_kafka_kafka_clients",
        "@maven//:org_hamcrest_hamcrest_all",
        "@maven//:org_mockito_mockito_core",
        "@maven//:org_rocksdb_rocksdbjni",
    ],
)

jvm_junit_test_classes(
    name = "ksqldb-rocksdb-config-setter-test-suite",
    data = KSQL_TEST_DATA,
    jvm_flags = KSQL_TEST_JVM_FLAGS,
    test_lib = ":ksqldb-rocksdb-config-setter-tests",
    test_srcs = [
        "src/test/java/io/confluent/ksql/rocksdb/KsqlBoundedMemoryRocksDBConfigSetterTest.java",
        "src/test/java/io/confluent/ksql/rocksdb/KsqlBoundedMemoryRocksDBConfigTest.java",
    ],
    runtime_deps = KSQL_TEST_RUNTIME_DEPS,
)
