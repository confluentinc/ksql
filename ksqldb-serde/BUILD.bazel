        "@maven//:com_google_guava_guava",
        "@maven//:com_google_guava_guava_testlib",
        "@maven//:com_google_protobuf_protobuf_java",
        "@maven//:io_confluent_kafka_avro_serializer",
        "@maven//:io_confluent_kafka_connect_avro_converter",
        "@maven//:io_confluent_kafka_connect_avro_data",
        "@maven//:io_confluent_kafka_connect_protobuf_converter",
        "@maven//:io_confluent_kafka_json_schema_provider",
