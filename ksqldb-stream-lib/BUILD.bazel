load("//tools-bazel:ksql_defs.bzl", "KSQL_PARENT_DEPS", "KSQL_TEST_DATA", "KSQL_TEST_JVM_FLAGS", "KSQL_TEST_RUNTIME_DEPS")
load("//tools-bazel:library_wrappers.bzl", "java_export", "java_library", "jvm_junit_test_classes")

java_export(
    name = "ksqldb-stream-lib",
    srcs = glob(["src/main/java/**/*.java"]),
    # Maven also publishes the test-jar (maven-jar-plugin test-jar goal).
    classifier_artifacts = {"tests": ":ksqldb-stream-lib-tests"},
    javacopts = ["-parameters"],
    maven_coordinates = "io.confluent.ksql:ksqldb-stream-lib:$(maven_version)",
    visibility = ["//visibility:public"],
    deps = KSQL_PARENT_DEPS + [
        "@maven//:it_unimi_dsi_fastutil",
        "@maven//:org_hamcrest_hamcrest_all",
    ],
)

# Stand-in for the Maven `tests` test-jar: the whole src/test tree,
# compiled once and shared by this module's tests and downstream modules.
java_library(
    name = "ksqldb-stream-lib-tests",
    srcs = glob(["src/test/java/**/*.java"]),
    javacopts = ["-parameters"],
    resource_strip_prefix = "ksqldb-stream-lib/src/test/resources",
    resources = glob(["src/test/resources/**"]),
    visibility = ["//visibility:public"],
    deps = KSQL_PARENT_DEPS + [
        ":ksqldb-stream-lib",
        "@maven//:colt_colt",
        "@maven//:com_google_guava_guava",
        "@maven//:com_googlecode_charts4j_charts4j",
        "@maven//:commons_codec_commons_codec",
        "@maven//:junit_junit",
        "@maven//:org_apache_mahout_mahout_math",
    ],
)

jvm_junit_test_classes(
    name = "ksqldb-stream-lib-test-suite",
    data = KSQL_TEST_DATA,
    jvm_flags = KSQL_TEST_JVM_FLAGS,
    test_lib = ":ksqldb-stream-lib-tests",
    test_srcs = [
        "src/test/java/com/clearspring/analytics/hash/TestLookup3Hash.java",
        "src/test/java/com/clearspring/analytics/hash/TestMurmurHash.java",
        "src/test/java/com/clearspring/analytics/stream/TestConcurrentStreamSummary.java",
        "src/test/java/com/clearspring/analytics/stream/TestSampleSet.java",
        "src/test/java/com/clearspring/analytics/stream/TestStochasticTopper.java",
        "src/test/java/com/clearspring/analytics/stream/TestStreamSummary.java",
        "src/test/java/com/clearspring/analytics/stream/cardinality/RegisterSetTest.java",
        "src/test/java/com/clearspring/analytics/stream/cardinality/TestAdaptiveCounting.java",
        "src/test/java/com/clearspring/analytics/stream/cardinality/TestAndGraphResults.java",
        "src/test/java/com/clearspring/analytics/stream/cardinality/TestCountThenEstimate.java",
        "src/test/java/com/clearspring/analytics/stream/cardinality/TestHyperLogLog.java",
        "src/test/java/com/clearspring/analytics/stream/cardinality/TestHyperLogLogPlus.java",
        "src/test/java/com/clearspring/analytics/stream/cardinality/TestICardinality.java",
        "src/test/java/com/clearspring/analytics/stream/cardinality/TestLinearCounting.java",
        "src/test/java/com/clearspring/analytics/stream/cardinality/TestLogLog.java",
        "src/test/java/com/clearspring/analytics/stream/frequency/ConservativeAddSketchTest.java",
        "src/test/java/com/clearspring/analytics/stream/frequency/CountMinSketchTest.java",
        "src/test/java/com/clearspring/analytics/stream/membership/Base64Test.java",
        "src/test/java/com/clearspring/analytics/stream/membership/BloomFilterTest.java",
        "src/test/java/com/clearspring/analytics/stream/membership/FilterTest.java",
        "src/test/java/com/clearspring/analytics/stream/quantile/GroupTreeTest.java",
        "src/test/java/com/clearspring/analytics/stream/quantile/QDigestTest.java",
        "src/test/java/com/clearspring/analytics/stream/quantile/TDigestTest.java",
        "src/test/java/com/clearspring/analytics/util/TestDoublyLinkedList.java",
        "src/test/java/com/clearspring/experimental/stream/cardinality/TestHyperBitBit.java",
    ],
    runtime_deps = KSQL_TEST_RUNTIME_DEPS,
)
