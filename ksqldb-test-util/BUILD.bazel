load("//tools-bazel:ksql_defs.bzl", "KSQL_PARENT_DEPS", "KSQL_TEST_DATA", "KSQL_TEST_JVM_FLAGS", "KSQL_TEST_RUNTIME_DEPS", "classes_dir", "classes_dir_test_args")
load("//tools-bazel:library_wrappers.bzl", "java_export", "java_library", "jvm_junit_test_classes")

java_export(
    name = "ksqldb-test-util",
    srcs = glob(["src/main/java/**/*.java"]),
    # java_export drops entries also present in a dependency"s jar; these are
    # this module"s own resources (a dependency ships a same-named root file).
    allowed_duplicate_names = ["log4j2.yaml"],
    # Maven also publishes the test-jar (maven-jar-plugin test-jar goal).
    classifier_artifacts = {"tests": ":ksqldb-test-util-tests"},
    javacopts = ["-parameters"],
    maven_coordinates = "io.confluent.ksql:ksqldb-test-util:$(maven_version)",
    plugins = [
        "//third_party:log4j_graalvm_processor",
        "//third_party:log4j_plugin_processor",
    ],
    resource_strip_prefix = "ksqldb-test-util/src/main/resources",
    resources = glob(["src/main/resources/**"]),
    visibility = ["//visibility:public"],
    deps = KSQL_PARENT_DEPS + [
        "@maven//:com_google_errorprone_error_prone_annotations",
        "@maven//:com_google_guava_guava",
        "@maven//:com_google_guava_guava_testlib",
        "@maven//:io_confluent_ce_sbk_2_13",
        "@maven//:junit_junit",
        "@maven//:org_apache_kafka_kafka_2_13",
        "@maven//:org_apache_kafka_kafka_2_13_test",
        "@maven//:org_apache_kafka_kafka_clients",
        "@maven//:org_apache_kafka_kafka_clients_test",
        "@maven//:org_apache_kafka_kafka_server_common_test",
        "@maven//:org_apache_kafka_kafka_test_common_internal_api",
        "@maven//:org_apache_kafka_kafka_test_common_runtime",
        "@maven//:org_easymock_easymock",
        "@maven//:org_hamcrest_hamcrest_all",
        "@maven//:org_mockito_mockito_core",
    ],
)

# Stand-in for the Maven `tests` test-jar: the whole src/test tree,
# compiled once and shared by this module's tests and downstream modules.
java_library(
    name = "ksqldb-test-util-tests",
    srcs = glob(["src/test/java/**/*.java"]),
    javacopts = ["-parameters"],
    visibility = ["//visibility:public"],
    deps = KSQL_PARENT_DEPS + [
        ":ksqldb-test-util",
        "@maven//:com_google_errorprone_error_prone_annotations",
        "@maven//:com_google_guava_guava",
        "@maven//:junit_junit",
        "@maven//:org_easymock_easymock",
    ],
)

# Exploded main classes for ClassFinder-based tests (see ksql_defs.bzl).
classes_dir(
    name = "ksqldb-test-util-classes",
    lib = ":ksqldb-test-util-lib",
)

jvm_junit_test_classes(
    name = "ksqldb-test-util-test-suite",
    data = KSQL_TEST_DATA,
    jvm_flags = KSQL_TEST_JVM_FLAGS,
    per_test_args = {
        "src/test/java/io/confluent/ksql/test/util/ImmutableTesterTest.java": classes_dir_test_args("ksqldb-test-util"),
    },
    test_lib = ":ksqldb-test-util-tests",
    test_srcs = [
        "src/test/java/io/confluent/ksql/test/util/ImmutableTesterTest.java",
    ],
    runtime_deps = KSQL_TEST_RUNTIME_DEPS,
)

exports_files(["src/main/resources/log4j2.yaml"])
