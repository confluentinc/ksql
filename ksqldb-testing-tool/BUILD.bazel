load("//tools-bazel:ksql_defs.bzl", "KSQL_PARENT_DEPS", "KSQL_TEST_DATA", "KSQL_TEST_JVM_FLAGS", "KSQL_TEST_RUNTIME_DEPS", "classes_dir", "classes_dir_test_args", "module_cwd_files")
load("//tools-bazel:library_wrappers.bzl", "java_export", "java_library", "jvm_junit_test_classes")

java_export(
    name = "ksqldb-testing-tool",
    srcs = glob(["src/main/java/**/*.java"]),
    # Maven also publishes the test-jar (maven-jar-plugin test-jar goal).
    classifier_artifacts = {"tests": ":ksqldb-testing-tool-tests"},
    maven_coordinates = "io.confluent.ksql:ksqldb-testing-tool:$(maven_version)",
    visibility = ["//visibility:public"],
    deps = KSQL_PARENT_DEPS + [
        "//ksqldb-common:ksqldb-common-project",
        "//ksqldb-engine",
        "//ksqldb-execution:ksqldb-execution-project",
        "//ksqldb-metastore:ksqldb-metastore-project",
        "//ksqldb-parser",
        "//ksqldb-serde:ksqldb-serde-project",
        "//ksqldb-udf:ksqldb-udf-project",
        "@maven//:com_github_rvesse_airline",
        "@maven//:com_google_guava_guava",
        "@maven//:commons_io_commons_io",
        "@maven//:io_confluent_kafka_json_schema_provider",
        "@maven//:io_confluent_kafka_protobuf_provider",
        "@maven//:io_confluent_kafka_schema_registry_client",
        "@maven//:org_antlr_antlr4_runtime",
        "@maven//:org_apache_kafka_kafka_clients",
        "@maven//:org_apache_kafka_kafka_clients_test",
        "@maven//:org_apache_kafka_kafka_streams",
        "@maven//:org_apache_kafka_kafka_streams_test_utils",
    ],
)

# Stand-in for the Maven `tests` test-jar: the whole src/test tree,
# compiled once and shared by this module's tests and downstream modules.
java_library(
    name = "ksqldb-testing-tool-tests",
    srcs = glob(["src/test/java/**/*.java"]),
    resource_strip_prefix = "ksqldb-testing-tool/src/test/resources",
    resources = glob(["src/test/resources/**"]),
    visibility = ["//visibility:public"],
    deps = KSQL_PARENT_DEPS + [
        ":ksqldb-testing-tool",
        "//ksqldb-common:ksqldb-common-project",
        "//ksqldb-execution:ksqldb-execution-project",
        "//ksqldb-parser:ksqldb-parser-project",
        "//ksqldb-test-util",
        "@maven//:com_google_guava_guava",
        "@maven//:junit_junit",
        "@maven//:org_antlr_antlr4_runtime",
        "@maven//:org_apache_kafka_connect_api",
        "@maven//:org_apache_kafka_kafka_clients",
        "@maven//:org_apache_kafka_kafka_streams",
        "@maven//:org_apache_kafka_kafka_streams_test_utils",
        "@maven//:org_hamcrest_hamcrest_all",
        "@maven//:org_mockito_mockito_core",
    ],
)

# Exploded main classes for ClassFinder-based tests (see ksql_defs.bzl).
classes_dir(
    name = "ksqldb-testing-tool-classes",
    lib = ":ksqldb-testing-tool-lib",
)

# Module files at module-relative paths: surefire's cwd is the module dir.
module_cwd_files(
    name = "ksqldb-testing-tool-cwd",
    srcs = glob(["src/test/resources/**"]),
)

jvm_junit_test_classes(
    name = "ksqldb-testing-tool-test-suite",
    data = KSQL_TEST_DATA + [":ksqldb-testing-tool-cwd"],
    jvm_flags = KSQL_TEST_JVM_FLAGS,
    per_test_args = {
        "src/test/java/io/confluent/ksql/tools/test/functional/ImmutabilityTest.java": classes_dir_test_args("ksqldb-testing-tool"),
    },
    test_lib = ":ksqldb-testing-tool-tests",
    test_srcs = [
        "src/test/java/io/confluent/ksql/tools/test/SqlTestingToolTest.java",
        "src/test/java/io/confluent/ksql/tools/test/driver/AssertExecutorMetaTest.java",
        "src/test/java/io/confluent/ksql/tools/test/driver/TestDriverPipelineTest.java",
        "src/test/java/io/confluent/ksql/tools/test/functional/ImmutabilityTest.java",
        "src/test/java/io/confluent/ksql/tools/test/parser/SqlTestReaderTest.java",
        "src/test/java/io/confluent/ksql/tools/test/parser/TestDirectiveTest.java",
    ],
    runtime_deps = KSQL_TEST_RUNTIME_DEPS,
)
