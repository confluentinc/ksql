load("//tools-bazel:ksql_defs.bzl", "KSQL_DUMMY_LICENSE_FIRST", "KSQL_PARENT_DEPS", "KSQL_TEST_DATA", "KSQL_TEST_JVM_FLAGS", "KSQL_TEST_RUNTIME_DEPS")
load("//tools-bazel:library_wrappers.bzl", "java_export", "java_library", "jvm_junit_test_classes")

java_export(
    name = "ksqldb-tools",
    srcs = glob(["src/main/java/**/*.java"]),
    # Maven also publishes the test-jar (maven-jar-plugin test-jar goal).
    classifier_artifacts = {"tests": ":ksqldb-tools-tests"},
    maven_coordinates = "io.confluent.ksql:ksqldb-tools:$(maven_version)",
    resource_strip_prefix = "ksqldb-tools/src/main/resources",
    resources = glob(["src/main/resources/**"]),
    visibility = ["//visibility:public"],
    deps = KSQL_PARENT_DEPS + [
        "//ksqldb-api-client",
        "//ksqldb-common",
        "//ksqldb-execution:ksqldb-execution-project",
        "//ksqldb-metastore:ksqldb-metastore-project",
        "//ksqldb-parser",
        "@maven//:com_github_rvesse_airline",
        "@maven//:com_google_guava_guava",
        "@maven//:javax_inject_javax_inject",
        "@maven//:net_java_dev_jna_jna",
        "@maven//:org_apache_commons_commons_lang3",
        "@maven//:org_apache_kafka_kafka_clients",
    ],
)

# Stand-in for the Maven `tests` test-jar: the whole src/test tree,
# compiled once and shared by this module's tests and downstream modules.
java_library(
    name = "ksqldb-tools-tests",
    srcs = glob(["src/test/java/**/*.java"]),
    visibility = ["//visibility:public"],
    deps = KSQL_PARENT_DEPS + [
        ":ksqldb-tools",
        "//ksqldb-api-client:ksqldb-api-client-project",
        "//ksqldb-common:ksqldb-common-project",
        "//ksqldb-engine:ksqldb-engine-project",
        "//ksqldb-engine:ksqldb-engine-tests",
        "//ksqldb-execution:ksqldb-execution-project",
        "//ksqldb-parser:ksqldb-parser-project",
        "//ksqldb-rest-app",
        "//ksqldb-rest-app:ksqldb-rest-app-tests",
        "//ksqldb-rest-model:ksqldb-rest-model-project",
        "//ksqldb-test-util",
        "@maven//:com_github_rvesse_airline",
        "@maven//:com_google_guava_guava",
        "@maven//:junit_junit",
        "@maven//:org_apache_kafka_connect_api",
        "@maven//:org_apache_kafka_connect_json",
        "@maven//:org_apache_kafka_connect_test_plugins",
        "@maven//:org_apache_kafka_kafka_clients",
        "@maven//:org_apache_kafka_kafka_clients_test",
        "@maven//:org_apache_kafka_kafka_raft",
        "@maven//:org_apache_kafka_kafka_streams",
        "@maven//:org_hamcrest_hamcrest_all",
        "@maven//:org_mockito_mockito_core",
    ],
)

jvm_junit_test_classes(
    name = "ksqldb-tools-test-suite",
    classpath_first = KSQL_DUMMY_LICENSE_FIRST,
    data = KSQL_TEST_DATA,
    integration_srcs = [
        "src/test/java/io/confluent/ksql/tools/migrations/MigrationsTest.java",
    ],
    jvm_flags = KSQL_TEST_JVM_FLAGS,
    test_lib = ":ksqldb-tools-tests",
    test_srcs = [
        "src/test/java/io/confluent/ksql/tools/migrations/MigrationsParsingTest.java",
        "src/test/java/io/confluent/ksql/tools/migrations/MigrationsTest.java",
        "src/test/java/io/confluent/ksql/tools/migrations/commands/ApplyMigrationCommandTest.java",
        "src/test/java/io/confluent/ksql/tools/migrations/commands/CreateMigrationCommandTest.java",
        "src/test/java/io/confluent/ksql/tools/migrations/commands/DestroyMigrationsCommandTest.java",
        "src/test/java/io/confluent/ksql/tools/migrations/commands/InitializeMigrationCommandTest.java",
        "src/test/java/io/confluent/ksql/tools/migrations/commands/MigrationInfoCommandTest.java",
        "src/test/java/io/confluent/ksql/tools/migrations/commands/NewMigrationCommandTest.java",
        "src/test/java/io/confluent/ksql/tools/migrations/commands/ValidateMigrationsCommandTest.java",
        "src/test/java/io/confluent/ksql/tools/migrations/util/CommandParserTest.java",
        "src/test/java/io/confluent/ksql/tools/migrations/util/MigrationVersionInfoFormatterTest.java",
        "src/test/java/io/confluent/ksql/tools/migrations/util/MigrationsDirectoryUtilTest.java",
        "src/test/java/io/confluent/ksql/tools/migrations/util/MigrationsUtilTest.java",
        "src/test/java/io/confluent/ksql/tools/migrations/util/ServerVersionUtilTest.java",
    ],
    runtime_deps = KSQL_TEST_RUNTIME_DEPS,
)
