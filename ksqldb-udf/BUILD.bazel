load("//tools-bazel:ksql_defs.bzl", "KSQL_PARENT_DEPS", "KSQL_TEST_DATA", "KSQL_TEST_JVM_FLAGS", "KSQL_TEST_RUNTIME_DEPS", "classes_dir", "classes_dir_test_args")
load("//tools-bazel:library_wrappers.bzl", "java_export", "java_library", "jvm_junit_test_classes")

java_export(
    name = "ksqldb-udf",
    srcs = glob(["src/main/java/**/*.java"]),
    # Maven also publishes the test-jar (maven-jar-plugin test-jar goal).
    classifier_artifacts = {"tests": ":ksqldb-udf-tests"},
    javacopts = ["-parameters"],
    maven_coordinates = "io.confluent.ksql:ksqldb-udf:$(maven_version)",
    visibility = ["//visibility:public"],
    deps = KSQL_PARENT_DEPS + [
        "@maven//:com_google_errorprone_error_prone_annotations",
        "@maven//:com_google_guava_guava",
        "@maven//:io_confluent_kafka_connect_json_schema_converter",
    ],
)

# Stand-in for the Maven `tests` test-jar: the whole src/test tree,
# compiled once and shared by this module's tests and downstream modules.
java_library(
    name = "ksqldb-udf-tests",
    srcs = glob(["src/test/java/**/*.java"]),
    javacopts = ["-parameters"],
    visibility = ["//visibility:public"],
    deps = KSQL_PARENT_DEPS + [
        ":ksqldb-udf",
        "//ksqldb-test-util",
        "@maven//:com_google_guava_guava",
        "@maven//:com_google_guava_guava_testlib",
        "@maven//:junit_junit",
        "@maven//:org_hamcrest_hamcrest",
        "@maven//:org_mockito_mockito_core",
    ],
)

# Exploded main classes for ClassFinder-based tests (see ksql_defs.bzl).
classes_dir(
    name = "ksqldb-udf-classes",
    lib = ":ksqldb-udf-lib",
)

jvm_junit_test_classes(
    name = "ksqldb-udf-test-suite",
    data = KSQL_TEST_DATA,
    jvm_flags = KSQL_TEST_JVM_FLAGS,
    per_test_args = {
        "src/test/java/io/confluent/ksql/schema/ksql/types/SqlTypesTest.java": classes_dir_test_args("ksqldb-udf"),
    },
    test_lib = ":ksqldb-udf-tests",
    test_srcs = [
        "src/test/java/io/confluent/ksql/function/udaf/VariadicArgsTest.java",
        "src/test/java/io/confluent/ksql/schema/ksql/SqlArgumentTest.java",
        "src/test/java/io/confluent/ksql/schema/ksql/types/SqlArrayTest.java",
        "src/test/java/io/confluent/ksql/schema/ksql/types/SqlDecimalTest.java",
        "src/test/java/io/confluent/ksql/schema/ksql/types/SqlMapTest.java",
        "src/test/java/io/confluent/ksql/schema/ksql/types/SqlPrimitiveTypeTest.java",
        "src/test/java/io/confluent/ksql/schema/ksql/types/SqlStructTest.java",
        "src/test/java/io/confluent/ksql/schema/ksql/types/SqlTypesTest.java",
        "src/test/java/io/confluent/ksql/types/KsqlStructTest.java",
    ],
    runtime_deps = KSQL_TEST_RUNTIME_DEPS,
)
