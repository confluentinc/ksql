load("@rules_java//java:defs.bzl", "java_binary")

# Build-time code generators replacing Maven plugins (same tool versions as the
# poms: antlr4-maven-plugin ${antlr.version}, avro-maven-plugin ${avro.version}).
java_binary(
    name = "antlr4_tool",
    main_class = "org.antlr.v4.Tool",
    visibility = ["//visibility:public"],
    runtime_deps = ["@maven//:org_antlr_antlr4"],
)

java_binary(
    name = "avro_compiler",
    srcs = ["AvroSpecificCompiler.java"],
    main_class = "tools.bazel.codegen.AvroSpecificCompiler",
    visibility = ["//visibility:public"],
    deps = [
        "@maven//:org_apache_avro_avro",
        "@maven//:org_apache_avro_avro_compiler",
    ],
)
